{
  "name": "morphlet",
  "version": "1.3.0",
  "description": "Local-first desktop file conversion with a radial drop menu",
  "license": "MIT",
  "author": "Mayank Kumar Jha",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "build:native": "node native/build.cjs",
    "postinstall": "node native/build.cjs",
    "studio": "electron . --studio",
    "icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "html-to-text": "^9.0.5",
    "imagetracerjs": "1.2.6",
    "marked": "^16.0.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^2.4.0",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "^0.17.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.morphlet.desktop",
    "productName": "Morphlet",
    "files": [
      "*.cjs",
      "ui/**/*",
      "LICENSE",
      "native/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "native/*.node",
      "native/*.ps1"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Morphlet reads the files you select in Finder when you tap your configured selection key.",
        "LSUIElement": true
      },
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Mayank Kumar Jha",
      "icon": "assets/icon.png"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "homepage": "https://github.com/the-mayankjha/morphlet",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-mayankjha/morphlet.git"
  },
  "bugs": {
    "url": "https://github.com/the-mayankjha/morphlet/issues"
  }
}
